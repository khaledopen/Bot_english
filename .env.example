# Configuration du bot Telegram tuteur d'anglais

# Ton token de bot Telegram fourni par @BotFather
TELEGRAM_BOT_TOKEN=ton_token_telegram_ici

# Ta clé API OpenAI (commence par sk-...)
OPENAI_API_KEY=ta_cle_openai_ici


# Suivi privé de l’activité Telegram
ADMIN_USER_ID=
ADMIN_CHANNEL_ID=
ADMIN_ACTIVITY_FILE=data/admin-activity.jsonl
ADMIN_DATABASE_URL=

# Espace Web (facultatif : utilise ADMIN_DATABASE_URL si vide)
WEB_DATABASE_URL=

# Connexion par email (Supabase Auth) — URL du projet et clé publique (sb_publishable_…)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Facultatif : clé secrète (sb_secret_…) pour supprimer aussi l’utilisateur Supabase quand il supprime son compte
SUPABASE_SECRET_KEY=
# Espace admin du site : emails des comptes admin, séparés par des virgules
ADMIN_EMAILS=

# Voix de Nova : "groq" (voix naturelle Orpheus, même clé GROQ_API_KEY) ou "google" (ancienne voix)
NOVA_TTS=groq
# Voix Orpheus : autumn, diana, hannah (féminines) ; austin, daniel, troy (masculines)
NOVA_VOICE=hannah
